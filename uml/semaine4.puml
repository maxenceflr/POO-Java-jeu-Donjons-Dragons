            }

            class ArmeMagique implements Sorts
            {
                + toString()
                + lancerSort(cible: Personnage, arme_cible: Arme): ActionResult
            }

        }


        package classe
        {
            abstract class Classe <<abstract>>
            {
                # m_pv: Integer
                # m_sorts: Sorts[*]
                # m_equipement: Equipement[*]
                + <<create>> Classe(pv: Integer)
                + <<create>> Classe(pv: Integer, equipement: Equipement[*])
                + <<create>> Classe(pv: Integer, equipement: Equipement[*], sorts: Sorts[*])
                + toString(): String
                + getPvClasse(): Integer
                + {abstract} ajouterClasseInitPerso()
                + getPv(): Integer
                + getListeEquipement(): Equipement[*]
                + getSorts(): Sorts[*]
                + equals(other: Object): Boolean
            }

            class Guerrier extends Classe
            {
                + <<create>> Guerrier()
                + toString(): String
                + ajouterClasseInitPerso()
            }

            class Clerc extends Classe
            {
                + <<create>> Clerc()
                + toString(): String
                + ajouterClasseInitPerso()
            }

            class Magicien extends Classe
            {
                + <<create>> Magicien()
                + toString(): String
                + ajouterClasseInitPerso()
            }

            class Roublard extends Classe
            {
                + <<create>> Roublard()
                + toString(): String
                + ajouterClasseInitPerso()
            }
        }
    }

