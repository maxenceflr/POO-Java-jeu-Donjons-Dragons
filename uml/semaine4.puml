        + {abstract} setId(id: Integer)
        + {abstract} toString(): String
        + {abstract} getSymbole(): String
        + {abstract} getNom(): String
        + {abstract} setSymbole(symbole: String)
        + getCurrentPv(): Integer
        + getPvMax(): Integer
        + getDexterite(): Integer
        + getVitesse(): Integer
        + getInit(): Integer
        + getForce(): Integer
        + getClasseArmure(): Integer
        + setPv()
        + setDexterite()
        + setVitesse()
        + setInit(
        + setForce()
        + setClasseArmure()
    }

    jouable.Jouable .> donjon.Donjon

    enum ActionResult <<enumerate>>
    {
        SUCCESS
        OBSTACLE
        OUT_OF_REACH
        FAILURE
        NO_ITEM
        NO_WEAPON
        ITEM
        OCCUPIED_POSITION
        OUT_OF_BONDS
    }

    class AttackResult
    {
        - m_status: ActionResult
        - m_jetAttaque: Integer
        - m_degats: Integer
        + <<create>> AttackResult(status: ActionResult, jetAttaque: Integer, degats: Integer)
        + getStatus(): AttackResult
        + getJetAttaque(): Integer
        + getDeDegats(): Integer
    }

    AttackResult .> ActionResult : <<use>>

